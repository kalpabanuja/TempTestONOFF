# Valheim Admin Panel Configuration

# Admin login credentials (Full access: Dashboard + Server Control + User Activity)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# User login credentials (Dashboard access only)
USER_USERNAME=
USER_PASSWORD=

# JWT secret (change this to a strong random string in production!)
JWT_SECRET=valheim_super_secret_key_change_me

# Server port
PORT=

# Docker container name (must match your docker-compose service name or container name)
VALHEIM_CONTAINER=#container_name
